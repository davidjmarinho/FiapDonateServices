{
    "info": {
        "_postman_id": "3d7b0d0d-1ef2-4c32-8dce-cfef1a7b5c28",
        "name": "FiapDonate - Local",
        "description": "Fluxo completo de autenticação, campanha, doação e verificação do RabbitMQ para o ambiente local. Usa /api/users, /api/campaign, /api/doacoes e a fila doacao-recebida-queue.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Users Register",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"doador.postman@fiapdonate.com\",\n  \"senha\": \"Senha@123\",\n  \"nome\": \"Doador Postman\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{host}}:{{usersPort}}/api/users/register",
                    "host": [
                        "{{host}}"
                    ],
                    "port": "{{usersPort}}",
                    "path": [
                        "api",
                        "users",
                        "register"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Doador Login",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "if (body && body.token) {",
                            "  pm.environment.set('tokenDoador', body.token);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"doador.postman@fiapdonate.com\",\n  \"senha\": \"Senha@123\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{host}}:{{usersPort}}/api/users/login",
                    "host": [
                        "{{host}}"
                    ],
                    "port": "{{usersPort}}",
                    "path": [
                        "api",
                        "users",
                        "login"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Gestor Login",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "if (body && body.token) {",
                            "  pm.environment.set('tokenGestor', body.token);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email\": \"gestor@fiapdonate.com\",\n  \"senha\": \"Gestor@123\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{host}}:{{usersPort}}/api/users/login",
                    "host": [
                        "{{host}}"
                    ],
                    "port": "{{usersPort}}",
                    "path": [
                        "api",
                        "users",
                        "login"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Campaign Create",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const body = pm.response.json();",
                            "if (body && (body.id || body.campaignId || body.Id)) {",
                            "  pm.environment.set('campaignId', body.id || body.campaignId || body.Id);",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{tokenGestor}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"titulo\": \"Campanha de Teste\",\n  \"descricao\": \"Validação de fluxo end-to-end\",\n  \"dataInicio\": \"2026-09-30T02:33:10\",\n  \"dataFim\": \"2026-10-30T02:33:10\",\n  \"metaFinanceira\": 1000.00\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{host}}:{{campaignPort}}/api/campaign",
                    "host": [
                        "{{host}}"
                    ],
                    "port": "{{campaignPort}}",
                    "path": [
                        "api",
                        "campaign"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Donation Create",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{tokenDoador}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"idCampanha\": \"{{campaignId}}\",\n  \"valorDoacao\": 150.00\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{host}}:{{campaignPort}}/api/doacoes",
                    "host": [
                        "{{host}}"
                    ],
                    "port": "{{campaignPort}}",
                    "path": [
                        "api",
                        "doacoes"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "Campaign Get",
            "request": {
                "auth": {
                    "type": "bearer",
                    "bearer": [
                        {
                            "key": "token",
                            "value": "{{tokenDoador}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{host}}:{{campaignPort}}/api/campaign/{{campaignId}}",
                    "host": [
                        "{{host}}"
                    ],
                    "port": "{{campaignPort}}",
                    "path": [
                        "api",
                        "campaign",
                        "{{campaignId}}"
                    ]
                }
            },
            "response": []
        },
        {
            "name": "RabbitMQ Queues",
            "request": {
                "auth": {
                    "type": "basic",
                    "basic": [
                        {
                            "key": "username",
                            "value": "{{rabbitUser}}",
                            "type": "string"
                        },
                        {
                            "key": "password",
                            "value": "{{rabbitPass}}",
                            "type": "string"
                        }
                    ]
                },
                "method": "GET",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    }
                ],
                "url": {
                    "raw": "{{host}}:{{rabbitPort}}/api/queues/%2F/doacao-recebida-queue",
                    "host": [
                        "{{host}}"
                    ],
                    "port": "{{rabbitPort}}",
                    "path": [
                        "api",
                        "queues",
                        "%2F",
                        "doacao-recebida-queue"
                    ]
                }
            },
            "response": []
        }
    ],
