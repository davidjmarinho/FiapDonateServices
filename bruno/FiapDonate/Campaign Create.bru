  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Campanha de Teste",
    "description": "Validação de fluxo end-to-end",
    "goal": 1000.00,
    "initialValue": 0.00
  }
}
